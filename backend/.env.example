# PehchaanAI Environment Configuration Template
# Copy this file to `backend/.env` after cloning and fill in your local values.
# Never commit `backend/.env` (it is already listed in .gitignore).

# Server
HOST=0.0.0.0
PORT=8000

# Redis (active live KYC sessions, 15-min default TTL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=900

# PostgreSQL (update user/password to match your local pgAdmin setup)
DATABASE_URL=postgresql://kyc_user:your_postgres_password@localhost:5432/kyc_db

# Security (use a strong random string; also derives Fernet Vault & JWT keys if VAULT_KEY is blank)
SECRET_KEY=change-this-to-a-long-random-secret
VAULT_KEY=
VAULT_RETENTION_DAYS=30

# Reviewer Operations Portal (/dashboard)
DASHBOARD_PASSWORD=admin123

# Paths
UPLOADS_DIR=../uploads
FRONTEND_DIR=../frontend

# Optional: override Tesseract binary path if not in default Program Files or PATH
TESSERACT_CMD=

# Keep plaintext CV debug crops off disk by default (set true only while debugging)
DEBUG_SAVE_CROPS=false

# Optional AI Assistant LLM keys (leave blank to run 100% offline with local-grounded RAG)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
